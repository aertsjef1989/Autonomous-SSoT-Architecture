{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ssot", "destination": "/DEMO/index.html" },
    { "source": "/balaerion", "destination": "/balaerion/demo/index.html" },
    { "source": "/syndicate", "destination": "/syndicate/demo/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
