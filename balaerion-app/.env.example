# Unlisted Workspace Environment Template (Populate in .env.local and Vercel Dashboard)
# Never commit real secret values to Git.

# 1. Supabase (Explicit EU AWS Region: eu-central-1 or eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Owner Session, Single-Use Grants & Self-Hosted ALTCHA
OWNER_ACCESS_SECRET=
ALTCHA_HMAC_KEY=
GRANT_CODE_PEPPER=
GRANT_SESSION_SECRET=
IP_RATE_PEPPER=
COOLDOWN_MODE=off
EMAIL_COOLDOWN_PEPPER=
GRANT_DAILY_EMAIL_CAP=40

# 3. Optional Transactional Grant Email (Resend Free: 100/UTC day hard limit)
RESEND_API_KEY=
GRANT_FROM_EMAIL=

# 4. Card-Free Admitted Free-Tier LLM Providers (V3.0 Constraint 1.1: Gemini/Anthropic/Paid OpenAI excluded)
OVH_ENABLE_LIVE=0
OVH_AI_ENDPOINTS_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
OPENROUTER_API_KEY=

# 5. Optional Google Drive Service Account (Leave blank if using Zero-GCP Apps Script push or /admin upload)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
