# Unlisted Workspace Environment Template (Populate in .env.local and Vercel Dashboard)
# Never commit real secret values to Git.

# 1. Supabase (Explicit EU AWS Region: eu-central-1 or eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Owner Session (Unlimited Live Mode), Single-Use Grants & Self-Hosted ALTCHA
OWNER_ACCESS_SECRET=
ALTCHA_HMAC_KEY=
GRANT_CODE_PEPPER=
GRANT_SESSION_SECRET=
IP_RATE_PEPPER=
COOLDOWN_MODE=off
EMAIL_COOLDOWN_PEPPER=
GRANT_DAILY_EMAIL_CAP=40

# 3. Optional Transactional Grant Email (Resend Free: 100/UTC day hard limit) & Telegram Owner Alerts
RESEND_API_KEY=
GRANT_FROM_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# 4. Card-Free 12-Provider LLM Pool (Unset keys fall back automatically to deterministic mode)
# Core 6 Free Providers:
NVIDIA_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Extended 6 Card-Free Providers (EU Sovereign + Workers AI + Trial Pools):
OVH_ENABLE_LIVE=0
OVH_AI_ENDPOINTS_KEY=
CODESTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
COHERE_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# 5. Live Syndicate Sports & Odds Feeds (Optional; falls back to deterministic simulation when unset)
FOOTBALL_DATA_API_KEY=
THE_ODDS_API_KEY=

# 6. Optional Google Drive Service Account (Leave blank if using connected Drive CLI importer, Apps Script push, or /admin upload)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
